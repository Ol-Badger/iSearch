<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>iSearch</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>$(DefineConstants);WPF</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Common\AssemblyAccessors.cs" Link="Common\AssemblyAccessors.cs" />
    <Compile Include="..\Common\iSearch.cs" Link="Common\iSearch.cs" />
	<Compile Include="..\Common\PrivateProfile.cs" Link="Common\PrivateProfile.cs" />
    <Compile Include="..\Common\SearchHistory.cs" Link="Common\SearchHistory.cs" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\Common\find.ico" Link="Common\find.ico" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Common\" />
  </ItemGroup>

</Project>
